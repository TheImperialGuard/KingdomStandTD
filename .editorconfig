; Стиль кода проекта KingdomStandTD.
; Источник истины для Visual Studio; текстовое описание с обоснованиями — .claude/rules/code-style.md.
root = true

[*]
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.cs]
charset = utf-8-bom
indent_size = 4

# --- using-директивы ---------------------------------------------------------
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning   # неиспользуемый using

# --- явные типы вместо var ---------------------------------------------------
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning

# --- модификаторы доступа пишем явно -----------------------------------------
dotnet_style_require_accessibility_modifiers = always:warning
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# --- расстановка скобок (Allman) ---------------------------------------------
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_between_query_expression_clauses = true

# --- ИМЕНОВАНИЕ --------------------------------------------------------------
# Порядок правил значим: побеждает первое подходящее.
# Поэтому const идёт раньше правила для private-полей — иначе private const
# попал бы под _camelCase вместо UPPER_SNAKE_CASE.

# const -> UPPER_SNAKE_CASE (при любом модификаторе доступа)
dotnet_naming_rule.constants_are_upper_snake_case.severity = warning
dotnet_naming_rule.constants_are_upper_snake_case.symbols = all_constants
dotnet_naming_rule.constants_are_upper_snake_case.style = upper_snake_case

dotnet_naming_symbols.all_constants.applicable_kinds = field
dotnet_naming_symbols.all_constants.applicable_accessibilities = *
dotnet_naming_symbols.all_constants.required_modifiers = const

dotnet_naming_style.upper_snake_case.capitalization = all_upper
dotnet_naming_style.upper_snake_case.word_separator = _

# private-поля -> _camelCase (static readonly и readonly сюда же попадают)
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _

# public/protected/internal-поля -> PascalCase, без подчёркивания
dotnet_naming_rule.non_private_fields_are_pascal_case.severity = warning
dotnet_naming_rule.non_private_fields_are_pascal_case.symbols = non_private_fields
dotnet_naming_rule.non_private_fields_are_pascal_case.style = pascal_case

dotnet_naming_symbols.non_private_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_fields.applicable_accessibilities = public, protected, internal, protected_internal

# интерфейсы -> PascalCase с префиксом I.
# Обязательно раньше общего PascalCase-правила: иначе интерфейс совпадёт с ним
# первым и префикс I проверяться не будет.
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_start_with_i.style = i_pascal_case

dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *

dotnet_naming_style.i_pascal_case.capitalization = pascal_case
dotnet_naming_style.i_pascal_case.required_prefix = I

# свойства, методы, события, типы, namespace -> PascalCase
dotnet_naming_rule.members_are_pascal_case.severity = warning
dotnet_naming_rule.members_are_pascal_case.symbols = pascal_case_members
dotnet_naming_rule.members_are_pascal_case.style = pascal_case

dotnet_naming_symbols.pascal_case_members.applicable_kinds = property, method, event, class, struct, interface, enum, delegate, namespace
dotnet_naming_symbols.pascal_case_members.applicable_accessibilities = *

# локальные переменные и параметры -> camelCase
dotnet_naming_rule.locals_are_camel_case.severity = warning
dotnet_naming_rule.locals_are_camel_case.symbols = locals_and_parameters
dotnet_naming_rule.locals_are_camel_case.style = camel_case

dotnet_naming_symbols.locals_and_parameters.applicable_kinds = parameter, local
dotnet_naming_symbols.locals_and_parameters.applicable_accessibilities = *

dotnet_naming_style.camel_case.capitalization = camel_case
dotnet_naming_style.pascal_case.capitalization = pascal_case

# --- сгенерированный код анализом не трогаем ---------------------------------
[**/Generated/**.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
