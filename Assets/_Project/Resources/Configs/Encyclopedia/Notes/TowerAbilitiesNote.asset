  <Picture>k__BackingField: {fileID: 0}
  <Title>k__BackingField: "\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u0431\u0430\u0448\u0435\u043D"
  <Text>k__BackingField: "\u041D\u0430 IV \u0443\u0440\u043E\u0432\u043D\u0435 \u0443
    \u0431\u0430\u0448\u043D\u0438 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u0434\u0432\u0435 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438.\n\u0423
    \u043B\u0443\u0447\u043D\u0438\u043A\u043E\u0432 \u044D\u0442\u043E \u0433\u0440\u0430\u0434
    \u0441\u0442\u0440\u0435\u043B \u0438 \u043E\u0442\u0440\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0435
    \u0441\u0442\u0440\u0435\u043B\u044B, \u0443 \u043C\u0430\u0433\u043E\u0432 \u2014
    \u0434\u0435\u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F
    \u0438 \u043C\u043E\u0440\u043E\u0437\u043D\u044B\u0439 \u0448\u0442\u043E\u0440\u043C,
    \u0443 \u043F\u0443\u0448\u043A\u0438 \u2014 \u043E\u0441\u043A\u043E\u043B\u043E\u0447\u043D\u044B\u0435
    \u0441\u043D\u0430\u0440\u044F\u0434\u044B \u0438 \u043E\u0433\u043B\u0443\u0448\u0435\u043D\u0438\u0435.\n\u0421\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u043A\u0443\u043F\u0430\u044E\u0442 \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u044E\u0442
    \u0437\u0430 \u0437\u043E\u043B\u043E\u0442\u043E."
