  <Title>k__BackingField: "\u041F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u0431\u0430\u0448\u0435\u043D"
  <Text>k__BackingField: "\u0411\u0430\u0448\u043D\u0438 \u0441\u0442\u0440\u043E\u044F\u0442
    \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0430\u0445 \u0443 \u0434\u043E\u0440\u043E\u0433\u0438:
    \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443
    \u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u0430\u0448\u043D\u044E.\n\u041B\u0443\u0447\u043D\u0438\u043A\u0438
    \u0441\u0442\u043E\u044F\u0442 70 \u0437\u043E\u043B\u043E\u0442\u0430, \u043C\u0430\u0433\u0438
    \u2014 100, \u043F\u0443\u0448\u043A\u0430 \u2014 125. \u0417\u043E\u043B\u043E\u0442\u043E
    \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u043F\u043E\u0431\u0435\u0436\u0434\u0451\u043D\u043D\u044B\u0435
    \u0432\u0440\u0430\u0433\u0438.\n\u0411\u0430\u0448\u043D\u044E \u043C\u043E\u0436\u043D\u043E
    \u0443\u043B\u0443\u0447\u0448\u0438\u0442\u044C \u0434\u043E IV \u0443\u0440\u043E\u0432\u043D\u044F
    \u0438\u043B\u0438 \u043F\u0440\u043E\u0434\u0430\u0442\u044C."
