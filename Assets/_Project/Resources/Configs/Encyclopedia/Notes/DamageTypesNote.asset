  <Picture>k__BackingField: {fileID: 0}
  <Title>k__BackingField: "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0438 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439 \u0443\u0440\u043E\u043D"
  <Text>k__BackingField: "\u041B\u0443\u0447\u043D\u0438\u043A\u0438 \u0438 \u043F\u0443\u0448\u043A\u0438
    \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0439
    \u0443\u0440\u043E\u043D, \u043C\u0430\u0433\u0438 \u2014 \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0439.\n\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0432\u0440\u0430\u0433\u0438 \u0437\u0430\u0449\u0438\u0449\u0435\u043D\u044B
    \u043E\u0442 \u043E\u0434\u043D\u043E\u0433\u043E \u0442\u0438\u043F\u0430 \u0443\u0440\u043E\u043D\u0430:
    \u0441\u043A\u0435\u043B\u0435\u0442-\u043C\u0430\u0433 \u0433\u0430\u0441\u0438\u0442
    85% \u043C\u0430\u0433\u0438\u0438, \u0432\u0430\u0440\u0432\u0430\u0440 \u2014
    50% \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430.\n\u041F\u0440\u043E\u0442\u0438\u0432
    \u0442\u0430\u043A\u0438\u0445 \u0432\u0440\u0430\u0433\u043E\u0432 \u0441\u0442\u0430\u0432\u044C\u0442\u0435
    \u0431\u0430\u0448\u043D\u0438 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0442\u0438\u043F\u0430."
