  m_text: "\u0418\u0441\u043F\u044B\u0442\u0430\u0439 \u0441\u0432\u043E\u0438 \u0441\u0438\u043B\u044B
    \u0432 \u0431\u0435\u0441\u043A\u043E\u043D\u0435\u0447\u043D\u043E\u043C \u0440\u0435\u0436\u0438\u043C\u0435
    \u0438 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0441\u044C \u043A\u0430\u043A
    \u043C\u043E\u0436\u043D\u043E \u0434\u043E\u043B\u044C\u0448\u0435. \u041F\u0435\u0440\u0435\u0434
    \u043D\u0430\u0447\u0430\u043B\u043E\u043C \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
    \u043E\u0437\u043D\u0430\u043A\u043E\u043C\u0438\u0442\u044C\u0441\u044F \u0441
    \u0431\u0430\u0437\u043E\u0432\u044B\u043C\u0438 \u0438\u0433\u0440\u043E\u0432\u044B\u043C\u0438
    \u043C\u0435\u0445\u0430\u043D\u0438\u043A\u0430\u043C\u0438, \u0431\u0430\u0448\u043D\u044F\u043C\u0438
    \u0438 \u0432\u0440\u0430\u0433\u0430\u043C\u0438. \u0421\u0434\u0435\u043B\u0430\u0442\u044C
    \u044D\u0442\u043E \u043C\u043E\u0436\u043D\u043E \u0432 \u044D\u043D\u0446\u0438\u043A\u043B\u043E\u043F\u0435\u0434\u0438\u0438
    \u0438\u043B\u0438 \u0438\u0433\u0440\u0430\u044F \u0432 \u043A\u0430\u043C\u043F\u0430\u043D\u0438\u044E."
